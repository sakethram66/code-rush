# Copy this file to .env and adjust as needed. All values shown are the defaults.

# --- Server ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
# Path to the SQLite database file.
DB_PATH=./data/coderush.db
# Set to true when serving over HTTPS so session cookies get the Secure flag.
COOKIE_SECURE=false
# Set to true when running behind a reverse proxy (nginx, Caddy, a load balancer) so
# X-Forwarded-* headers are trusted for client IPs (used by rate limiting and audit logs).
TRUST_PROXY=false

# --- First-run admin account ---
# If unset, a random admin account is created on first boot and printed once to the server log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Sessions ---
ADMIN_SESSION_HOURS=12
TEAM_SESSION_HOURS=8

# --- Contest defaults ---
# Default duration for a newly created batch (organisers can override per batch).
BATCH_MINUTES=25
# Maximum size of code a team can submit or run.
MAX_CODE_BYTES=65536
MAX_CUSTOM_INPUT_BYTES=65536
# Minimum time between a team's run/submit actions, to keep the judge queue fair.
SUBMISSION_COOLDOWN_MS=3000

# --- Login rate limiting ---
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MS=300000

# --- Judge sandbox ---
# Directory for per-run scratch files. Must sit somewhere world-traversable (see README "Security").
JUDGE_WORK_DIR=
# How many submissions/runs are judged in parallel.
# For a live contest, 4 is a safer default than 2.
JUDGE_CONCURRENCY=4
# Unprivileged uid/gid that judged code runs as (only used when the server itself runs as root).
JUDGE_UID=65534
JUDGE_GID=65534
JUDGE_COMPILE_TIMEOUT_MS=20000
JUDGE_MAX_OUTPUT_BYTES=1048576

# --- Seeding ---
# Import seed/questions.json automatically if the question bank is empty on boot.
SEED_ON_EMPTY=true
